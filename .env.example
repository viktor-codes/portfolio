# Copy to .env.local and fill in. Never commit real values.

# Canonical site URL (sitemap, Open Graph, JSON-LD). Production: https://ruramade.dev
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 — Web data stream Measurement ID (format G-XXXXXXXXXX).
# Loaded only after the user accepts analytics cookies.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Optional: Google Search Console HTML tag verification content value only.
GOOGLE_SITE_VERIFICATION=
