# Copy to .env.local and fill values. Never commit .env or .env.local.

# Canonical site URL (SEO, sitemap, JSON-LD). Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=

# Optional: Google Search Console HTML tag verification (content value only).
GOOGLE_SITE_VERIFICATION=

# Optional: GA4 only loads after analytics cookie consent (see AnalyticsGate).
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Resend API (contact form). https://resend.com/docs
RESEND_API_KEY=

# Verified sender in Resend (e.g. onboarding@resend.dev or your domain).
RESEND_FROM_EMAIL=

# Inbox that receives contact form submissions.
CONTACT_TO_EMAIL=

# On Vercel, VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL are set automatically for URL fallbacks.
